---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { Content as HomeText } from '../content/home.md';
import { Content as Goal } from '../content/goal.md';
import { Content as StudentNote, compiledContent as studentNoteHtml } from '../content/prospective-students.md';
import headshot from '../assets/headshot.jpg';
import Email from '../components/Email.astro';
import { SITE } from '../site';

// The prospective-students box is hidden when its Markdown file has no text.
const showNote = (await studentNoteHtml()).replace(/<!--[\s\S]*?-->/g, '').trim() !== '';

// Each news item is a short Markdown file in src/content/news/, sorted newest first.
// The newest 8 are shown; the rest sit under a collapsed "Older news" toggle.
const SHOWN = 8;
const items = (await getCollection('news')).sort((a, b) => +b.data.date - +a.data.date);
const all = await Promise.all(items.map(async (item) => ({ date: item.data.date, Content: (await render(item)).Content })));
const fmt = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---

<Base>
  <div class="home">
    <aside class="profile">
      <Image src={headshot} alt="Matthew Engelhard" width={400} class="headshot" />
      <p class="name">Matthew Engelhard</p>
      <p class="affil">{SITE.affiliation}</p>
      <ul class="links">
        <li><Email {...SITE.email} /></li>
        <li><a href={SITE.links.dukeScholars}>Duke Scholars</a></li>
        <li><a href={SITE.links.scholar}>Google Scholar</a></li>
        <li><a href={SITE.links.github}>GitHub</a></li>
        <li><a href={SITE.cv}>CV (PDF)</a></li>
      </ul>
    </aside>

    <div class="main">
      <!-- The lab name is already in the site header, so this heading is for screen readers and search engines only. -->
      <h1 class="visually-hidden">{SITE.name}</h1>
      <aside class="goal"><Goal /></aside>
      <HomeText />

      {showNote && (
        <aside class="note"><StudentNote /></aside>
      )}

      <h2>Lab news</h2>
      <ul class="news">
        {all.slice(0, SHOWN).map(({ date, Content }) => (
          <li>
            <span class="date">{fmt(date)}</span>
            <div class="item"><Content /></div>
          </li>
        ))}
      </ul>
      {all.length > SHOWN && (
        <details class="older">
          <summary>Older news</summary>
          <ul class="news">
            {all.slice(SHOWN).map(({ date, Content }) => (
              <li>
                <span class="date">{fmt(date)}</span>
                <div class="item"><Content /></div>
              </li>
            ))}
          </ul>
        </details>
      )}
    </div>
  </div>
</Base>

<style>
  .home { display: grid; grid-template-columns: 220px 1fr; gap: 2.5rem; }
  @media (max-width: 680px) {
    .home { grid-template-columns: 1fr; gap: 1.5rem; }
    .profile { display: grid; grid-template-columns: 110px 1fr; column-gap: 1rem; }
    .profile .headshot { grid-row: span 4; margin-bottom: 0; }
  }

  .headshot { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; margin-bottom: 0.75rem; }
  .name { font-weight: 600; margin: 0; }
  .affil { color: var(--muted); margin: 0 0 0.75rem; }
  .links { list-style: none; padding: 0; margin: 0; }
  .links li { margin: 0.15rem 0; }

  .visually-hidden {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }

  .goal {
    margin: 0 0 1.5rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--line);
    border-left: 4px solid var(--link);
    background: #f7f9fb;
    font-size: 1.1rem;
    line-height: 1.5;
  }
  .goal :global(p) { margin: 0; }

  .note {
    margin: 2rem 0 0;
    padding: 0.9rem 1.1rem;
    border: 1px solid var(--line);
    border-left: 4px solid var(--link);
    background: #f7f9fb;
  }
  .note :global(p) { margin: 0; }
  .note :global(p + p) { margin-top: 0.6rem; }

  .news { list-style: none; padding: 0; }
  .news li { display: grid; grid-template-columns: 7.5em 1fr; gap: 0.5rem; margin: 0.4rem 0; }
  .item :global(p) { margin: 0; }
  .date { color: var(--muted); }
  .older summary { cursor: pointer; color: var(--link); }
  @media (max-width: 680px) {
    .news li { grid-template-columns: 1fr; gap: 0; margin: 0.6rem 0; }
  }
</style>
