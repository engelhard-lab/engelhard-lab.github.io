---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Publication from '../components/Publication.astro';
import { SITE } from '../site';

const all = await getCollection('publications');
const articles = all.filter((p) => p.data.type === 'article');
const chapters = all.filter((p) => p.data.type === 'chapter');
const preprints = all.filter((p) => p.data.type === 'preprint');
// Entries keep their order from the YAML file within each year.
const years = [...new Set(articles.map((p) => p.data.year))].sort((a, b) => b - a);
---

<Base title="Publications" description="Publications from the Engelhard Lab.">
  <h1>Publications</h1>
  <p>
    See also <a href={SITE.links.scholar}>Google Scholar</a> and Matthew Engelhard's <a href={SITE.cv}>CV (PDF)</a>.
    <br /><span class="muted">* These authors jointly supervised this work.</span>
  </p>

  {preprints.length > 0 && (
    <section>
      <h2>Preprints</h2>
      <ul class="pubs">{preprints.map((pub) => <Publication pub={pub} />)}</ul>
    </section>
  )}

  {years.map((year) => (
    <section>
      <h2>{year}</h2>
      <ul class="pubs">
        {articles.filter((p) => p.data.year === year).map((pub) => <Publication pub={pub} />)}
      </ul>
    </section>
  ))}

  {chapters.length > 0 && (
    <section>
      <h2>Book chapters</h2>
      <ul class="pubs">{chapters.map((pub) => <Publication pub={pub} />)}</ul>
    </section>
  )}
</Base>

<style>
  .muted { color: var(--muted); font-size: 0.92rem; }
  .pubs { list-style: none; padding: 0; max-width: 820px; }
</style>
