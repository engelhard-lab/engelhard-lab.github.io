---
import { getEntries, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Publication from './Publication.astro';

interface Props {
  entry: CollectionEntry<'projects'> | CollectionEntry<'methods'>;
}

const { entry } = Astro.props;
const { title, image, imageAlt, publications } = entry.data;
const { Content } = await render(entry);
const pubs = await getEntries(publications);
---

<!-- Title, then the image (if any) at full text width, then the description and publications. -->
<article class="entry" id={entry.id}>
  <h2>{title}</h2>
  {'funding' in entry.data && entry.data.funding && (
    <p class="funding">
      {entry.data.funding}
      {entry.data.reporter && <> · <a href={entry.data.reporter}>NIH RePORTER</a></>}
    </p>
  )}
  {image && (
    <figure>
      <Image src={image} alt={imageAlt} width={1400} class="img" />
      {entry.data.imageCredit && <figcaption class="credit">{entry.data.imageCredit}</figcaption>}
    </figure>
  )}
  <Content />
  {pubs.length > 0 && (
    <>
      <h3>Representative publications</h3>
      <ul class="pubs">{pubs.map((pub) => <Publication pub={pub} />)}</ul>
    </>
  )}
</article>

<style>
  .entry { padding: 2rem 0; border-top: 1px solid var(--line); max-width: 820px; }
  h2 { margin-top: 0; }
  .funding { color: var(--muted); font-size: 0.92rem; margin-top: -0.4rem; }
  /* Centered, up to 4/5 of the text width (full width on phones), with a thin black border. */
  figure { width: 80%; margin: 1.75rem auto 1.5rem; }
  @media (max-width: 680px) { figure { width: 100%; } }
  .img { display: block; margin: 0 auto; width: auto; height: auto; max-width: 100%; max-height: 440px; border: 1px solid #000; }
  .credit { color: var(--muted); font-size: 0.8rem; margin-top: 0.35rem; text-align: center; }
  h3 { font-size: 0.95rem; margin: 1.25rem 0 0.5rem; }
  .pubs { list-style: none; padding: 0; margin: 0; font-size: 0.95rem; }
</style>
