---
import { Image } from 'astro:assets';

interface Props {
  slides: { image: ImageMetadata; caption?: string }[];
}

const { slides } = Astro.props;
---

<div class="slideshow" data-slideshow>
  {slides.length === 0 && <div class="frame placeholder">Team outing photos</div>}
  {slides.length > 0 && (
    <div class="frame">
      {slides.map((s, i) => (
        <figure class:list={['slide', { active: i === 0 }]} aria-hidden={i === 0 ? undefined : 'true'}>
          <Image src={s.image} alt={s.caption ?? 'Team outing'} width={1200} loading={i === 0 ? 'eager' : 'lazy'} />
          {s.caption && <figcaption>{s.caption}</figcaption>}
        </figure>
      ))}
    </div>
  )}
  {slides.length > 1 && (
    <div class="controls">
      <button type="button" data-prev aria-label="Previous photo">‹ Prev</button>
      <span data-count>1 / {slides.length}</span>
      <button type="button" data-next aria-label="Next photo">Next ›</button>
    </div>
  )}
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-slideshow]')) {
    const slides = [...root.querySelectorAll<HTMLElement>('.slide')];
    if (slides.length < 2) continue;
    const count = root.querySelector('[data-count]')!;
    let i = 0;
    const show = (n: number) => {
      slides[i].classList.remove('active');
      slides[i].setAttribute('aria-hidden', 'true');
      i = (n + slides.length) % slides.length;
      slides[i].classList.add('active');
      slides[i].removeAttribute('aria-hidden');
      count.textContent = `${i + 1} / ${slides.length}`;
    };
    let timer: number | undefined;
    const start = () => {
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) timer = window.setInterval(() => show(i + 1), 6000);
    };
    const stop = () => window.clearInterval(timer);
    root.querySelector('[data-prev]')!.addEventListener('click', () => { stop(); show(i - 1); });
    root.querySelector('[data-next]')!.addEventListener('click', () => { stop(); show(i + 1); });
    root.addEventListener('mouseenter', stop);
    start();
  }
</script>

<style>
  .frame { position: relative; aspect-ratio: 3 / 2; background: #f2f2f2; overflow: hidden; }
  .placeholder { display: grid; place-items: center; border: 1px solid var(--line); color: var(--muted); font-size: 0.9rem; }
  .slide { position: absolute; inset: 0; margin: 0; opacity: 0; transition: opacity 0.6s ease; }
  .slide.active { opacity: 1; }
  .slide :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: center 30%; }
  figcaption {
    position: absolute; left: 0; right: 0; bottom: 0; padding: 0.5rem 0.75rem;
    background: rgba(0, 0, 0, 0.55); color: #fff; font-size: 0.9rem;
  }
  .controls { display: flex; justify-content: space-between; align-items: center; margin-top: 0.5rem; font-size: 0.9rem; color: var(--muted); }
  button { font: inherit; background: none; border: 1px solid var(--line); padding: 0.25rem 0.75rem; cursor: pointer; color: var(--text); }
  button:hover { border-color: var(--muted); }
  @media (prefers-reduced-motion: reduce) { .slide { transition: none; } }
</style>
